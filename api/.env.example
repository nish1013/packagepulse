PP_ENV=development

# Shared with the web app. Required in production; generate with: openssl rand -hex 32
PP_SIGNING_SECRET=
# Set to the old value while rotating, then remove.
PP_SIGNING_SECRET_PREVIOUS=

# Fine-grained token with read-only access to public repositories.
PP_GITHUB_TOKEN=

PP_PACKAGE_REQUESTS_PER_MINUTE=30
PP_SCANS_PER_10_MINUTES=4
PP_STREAMS_PER_CLIENT=2
PP_CONCURRENT_SCANS=6
